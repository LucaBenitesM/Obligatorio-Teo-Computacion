import java_cup.runtime.*;
import java.math.BigInteger;

parser code {:
  public Diagnosticos diagnosticos = new Diagnosticos();
  public Validador validador = new Validador(diagnosticos);
  public PlanEntrenamiento plan;

  public void configurar(Diagnosticos errores) {
    diagnosticos = errores;
    validador = new Validador(errores);
  }

  @Override public void syntax_error(Symbol actual) {
    String token = actual.sym == sym.EOF ? "fin del archivo" : sym.terminalNames[actual.sym];
    diagnosticos.agregar("sintáctico", actual.left, "Se encontró " + token + " en una posición no válida.");
  }

  @Override public void unrecovered_syntax_error(Symbol actual) throws Exception {
    throw new Exception("No se pudo recuperar la estructura del archivo.");
  }
:};

terminal String STRING, NOMBRE, NUM, SERIES_X, PORCENTAJE, CARGA, TIEMPO,
                VELOCIDAD, VAL_DIA, VAL_INTENSIDAD, NIVEL_VAL, FECHA_VAL, TEXTO, CLAVE;
terminal PLAN, NIVEL, SEMANAS, OBJETIVOS, PROFESOR, FECHA, RUTINA, DIA,
         CALENTAMIENTO, EJERCICIOS, DURACION, MUSCULOS, VARIANTES, EQUIPAMIENTO,
         OBS, EXTRA, INTENSIDAD, FIN_SUPERSERIE, SUPERSERIE, VUELTAS,
         IGUAL_A, EXCEPTO, VEZ, VECES, DESCANSO, MAX, REPS, X,
         DOS_PUNTOS, ARROBA, IGUAL, LCORCH, RCORCH, COMA, EOL, INVALIDO;

non terminal PlanEntrenamiento plan, encabezado;
non terminal PlanEntrenamiento.Rutinas rutinas;
non terminal PlanEntrenamiento.Rutina rutina;
non terminal PlanEntrenamiento.Contenido contenido;
non terminal PlanEntrenamiento.Elementos ejercicios, ejercicios_superserie;
non terminal PlanEntrenamiento.Elemento elemento, ejercicio, superserie;
non terminal PlanEntrenamiento.Especificacion especificacion;
non terminal PlanEntrenamiento.Medida carga_opcional, descanso_opcional;
non terminal PlanEntrenamiento.Campos campos, campo;
non terminal PlanEntrenamiento.Nombres lista_nombres, excepto_opcional;
non terminal PlanEntrenamiento.Reutilizacion reutilizacion;
non terminal BigInteger repeticiones_opcionales;
non terminal String calentamiento_opcional, nombre_opcional;
non terminal eols;

start with plan;

plan ::= eols encabezado:p rutinas:r
  {: p.rutinas.addAll(r); parser.validador.completar(p); parser.plan = p; RESULT = p; :}
;

encabezado ::= PLAN STRING:n EOL eols
               NIVEL NIVEL_VAL:v EOL eols
               OBJETIVOS LCORCH lista_nombres:o RCORCH EOL eols
               SEMANAS NUM:s EOL eols
               PROFESOR STRING:p EOL eols
               FECHA FECHA_VAL:f EOL eols
  {:
    PlanEntrenamiento resultado = new PlanEntrenamiento();
    resultado.nombre = n; resultado.nivel = v; resultado.objetivos = o;
    resultado.semanas = parser.validador.semanas(s, sleft);
    resultado.profesor = p; resultado.fechaTexto = f;
    resultado.fecha = parser.validador.fecha(f, fleft);
    RESULT = resultado;
  :}
;

eols ::= /* vacío */ | eols EOL;

rutinas ::= rutina:r
  {: RESULT = new PlanEntrenamiento.Rutinas(); if (r != null) RESULT.add(r); :}
  | rutinas:rs rutina:r
  {: if (r != null) rs.add(r); RESULT = rs; :}
;

rutina ::= RUTINA STRING:n EOL eols DIA VAL_DIA:d EOL eols
           calentamiento_opcional:c contenido:co campos:ca
  {:
    PlanEntrenamiento.Rutina resultado = new PlanEntrenamiento.Rutina();
    resultado.nombre = n; resultado.linea = nleft; resultado.dia = d;
    resultado.contenido = co; resultado.declarados = new PlanEntrenamiento.Campos();
    resultado.declarados.calentamiento = c; resultado.declarados.aplicar(ca);
    parser.validador.nombre(n, nleft); RESULT = resultado;
  :}
  /* Se descarta la rutina mal formada y se sincroniza en RUTINA o EOF. */
  | RUTINA error {: RESULT = null; :}
  | INVALIDO error {: RESULT = null; :}
;

calentamiento_opcional ::= /* vacío */ {: RESULT = null; :}
  | CALENTAMIENTO TEXTO:t EOL eols {: RESULT = t; :}
;

contenido ::= EJERCICIOS EOL eols ejercicios:e
  {: RESULT = new PlanEntrenamiento.Contenido(); RESULT.ejercicios = e; :}
  | reutilizacion:r
  {: RESULT = new PlanEntrenamiento.Contenido(); RESULT.reutilizacion = r; :}
;

ejercicios ::= elemento:e
  {: RESULT = new PlanEntrenamiento.Elementos(); RESULT.add(e); :}
  | ejercicios:es elemento:e {: es.add(e); RESULT = es; :}
;

elemento ::= ejercicio:e EOL eols {: RESULT = e; :}
  | superserie:s {: RESULT = s; :}
;

ejercicio ::= NOMBRE:n DOS_PUNTOS especificacion:e
  {: parser.validador.nombre(n, nleft); RESULT = new PlanEntrenamiento.Elemento(n, nleft, e); :}
;

especificacion ::= SERIES_X:s NUM:r carga_opcional:c descanso_opcional:d
  {:
    RESULT = new PlanEntrenamiento.Especificacion("FUERZA");
    RESULT.series = parser.validador.positivo(s, sleft, "La cantidad de series");
    RESULT.repeticiones = parser.validador.positivo(r, rleft, "La cantidad de repeticiones");
    RESULT.carga = c; RESULT.descanso = d;
  :}
  | SERIES_X:s MAX descanso_opcional:d
  {:
    RESULT = new PlanEntrenamiento.Especificacion("FALLO");
    RESULT.series = parser.validador.positivo(s, sleft, "La cantidad de series"); RESULT.descanso = d;
  :}
  | SERIES_X:s TIEMPO:t descanso_opcional:d
  {:
    RESULT = new PlanEntrenamiento.Especificacion("ISOMETRICO");
    RESULT.series = parser.validador.positivo(s, sleft, "La cantidad de series");
    RESULT.tiempo = new PlanEntrenamiento.Medida(t, tleft); RESULT.descanso = d;
  :}
  | TIEMPO:t ARROBA VELOCIDAD:v
  {:
    RESULT = new PlanEntrenamiento.Especificacion("CARDIO");
    RESULT.tiempo = new PlanEntrenamiento.Medida(t, tleft);
    RESULT.velocidad = new PlanEntrenamiento.Medida(v, vleft);
  :}
  | TIEMPO:t
  {: RESULT = new PlanEntrenamiento.Especificacion("CARDIO"); RESULT.tiempo = new PlanEntrenamiento.Medida(t, tleft); :}
  | NUM:r REPS carga_opcional:c
  {:
    RESULT = new PlanEntrenamiento.Especificacion("REPETICIONES");
    RESULT.repeticiones = parser.validador.positivo(r, rleft, "La cantidad de repeticiones"); RESULT.carga = c;
  :}
;

carga_opcional ::= /* vacío */ {: RESULT = null; :}
  | ARROBA CARGA:c {: RESULT = parser.validador.carga(c, cleft); :}
;

descanso_opcional ::= /* vacío */ {: RESULT = null; :}
  | COMA DESCANSO TIEMPO:t {: RESULT = new PlanEntrenamiento.Medida(t, tleft); :}
;

nombre_opcional ::= /* vacío */ {: RESULT = null; :}
  | NOMBRE:n {: parser.validador.nombre(n, nleft); RESULT = n; :}
;

superserie ::= nombre_opcional:n SUPERSERIE:s NUM:v VUELTAS EOL eols
               ejercicios_superserie:e FIN_SUPERSERIE descanso_opcional:d EOL eols
  {:
    RESULT = new PlanEntrenamiento.Elemento(n, sleft, null);
    RESULT.vueltas = parser.validador.vueltas(v, vleft); RESULT.ejercicios = e; RESULT.descanso = d;
  :}
;

ejercicios_superserie ::= ejercicio:a EOL eols ejercicio:b EOL eols
  {: RESULT = new PlanEntrenamiento.Elementos(); RESULT.add(a); RESULT.add(b); :}
  | ejercicios_superserie:es ejercicio:e EOL eols {: es.add(e); RESULT = es; :}
;

reutilizacion ::= IGUAL_A STRING:n repeticiones_opcionales:r excepto_opcional:e EOL eols
  {:
    RESULT = new PlanEntrenamiento.Reutilizacion(); RESULT.nombre = n;
    RESULT.linea = nleft; RESULT.vueltas = r; RESULT.exclusiones = e;
  :}
;

repeticiones_opcionales ::= /* vacío */ {: RESULT = BigInteger.ONE; :}
  | X NUM:n VEZ {: RESULT = parser.validador.repeticion(n, true, nleft); :}
  | X NUM:n VECES {: RESULT = parser.validador.repeticion(n, false, nleft); :}
  | PORCENTAJE:n {: RESULT = parser.validador.porcentaje(n, nleft); :}
;

excepto_opcional ::= /* vacío */ {: RESULT = new PlanEntrenamiento.Nombres(); :}
  | EXCEPTO LCORCH lista_nombres:ns RCORCH {: RESULT = ns; :}
;

campos ::= /* vacío */ {: RESULT = new PlanEntrenamiento.Campos(); :}
  | campos:cs campo:c {: cs.aplicar(c); RESULT = cs; :}
;

campo ::= INTENSIDAD VAL_INTENSIDAD:i EOL eols
  {: RESULT = new PlanEntrenamiento.Campos(); RESULT.intensidad = i; :}
  | DURACION TIEMPO:t EOL eols
  {: RESULT = new PlanEntrenamiento.Campos(); RESULT.duracion = new PlanEntrenamiento.Medida(t, tleft); :}
  | MUSCULOS LCORCH lista_nombres:ns RCORCH EOL eols
  {: RESULT = new PlanEntrenamiento.Campos(); RESULT.musculos = ns; :}
  | EQUIPAMIENTO LCORCH lista_nombres:ns RCORCH EOL eols
  {: RESULT = new PlanEntrenamiento.Campos(); RESULT.equipamiento = ns; :}
  | VARIANTES LCORCH lista_nombres:ns RCORCH EOL eols
  {: RESULT = new PlanEntrenamiento.Campos(); RESULT.variantes = ns; :}
  | OBS TEXTO:t EOL eols
  {: RESULT = new PlanEntrenamiento.Campos(); RESULT.observaciones = t; :}
  | CALENTAMIENTO TEXTO:t EOL eols
  {: RESULT = new PlanEntrenamiento.Campos(); RESULT.calentamiento = t; :}
  | EXTRA CLAVE:c IGUAL TEXTO:t EOL eols
  {: RESULT = new PlanEntrenamiento.Campos(); RESULT.extra.put(c, t); :}
;

lista_nombres ::= NOMBRE:n
  {: RESULT = new PlanEntrenamiento.Nombres(); RESULT.add(n); :}
  | lista_nombres:ns COMA NOMBRE:n {: ns.add(n); RESULT = ns; :}
;
